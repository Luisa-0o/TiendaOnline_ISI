# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
# Vacío = SQLite local (nevora_dev.sqlite3). Producción: postgresql://usuario:clave@host:5432/base
DATABASE_URL=
# Opcionales: datos de contacto que se muestran en el pie de página
STORE_CONTACT_EMAIL=
STORE_CONTACT_PHONE=
STORE_CONTACT_ADDRESS=
STORE_CONTACT_HOURS=
# Opcional: base PostgreSQL para ejecutar las pruebas contra Postgres
# TEST_DATABASE_URL=
